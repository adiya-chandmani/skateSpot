# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only (sb_secret_…)

# Clerk (auth) — `clerk init` / `clerk env pull` fills these
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=                     # server only
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Kakao Developers app (https://developers.kakao.com) — one app, two keys
# JavaScript key: register the site domain under Platform > Web (e.g. http://localhost:3000)
NEXT_PUBLIC_KAKAO_MAP_KEY=
# REST API key: Local API (keyword search, coord→address). Server only.
KAKAO_REST_API_KEY=

# Ops
NEXT_PUBLIC_SITE_URL=https://skatespot.example
NEXT_PUBLIC_CONTACT_EMAIL=
OPERATOR_WEBHOOK_URL=                 # Slack/Discord webhook for priority reports
CRON_SECRET=                          # Vercel Cron bearer
